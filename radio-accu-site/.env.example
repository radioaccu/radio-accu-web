# Publish only the public website schedule tab as CSV in Google Sheets.
GOOGLE_SHEET_SCHEDULE_CSV_URL=

# The Guest Mix page stays hidden until the series launches. When enabled,
# publish only a dedicated Website GM tab (never the private form responses).
GM_SERIES_ENABLED=false
GOOGLE_SHEET_GM_CSV_URL=

# Reserved for the server-side Dropbox resident-image sync.
# A generated access token is suitable for the first local test.
DROPBOX_ACCESS_TOKEN=

# Use these three values for permanent background access in production.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_RESIDENTS_ROOT="/RADIO ACCU RESIDENTS"
# Optional: use an existing shared Dropbox folder without moving it into Apps.
DROPBOX_RESIDENTS_SHARED_LINK=

# Show-application e-mail delivery through the Radio ACCU Combell mailbox.
SMTP_HOST=smtp-auth.mailprotect.be
SMTP_PORT=465
SMTP_USER=info@radioaccu.com
SMTP_PASSWORD=
SMTP_FROM_NAME="Radio ACCU Website"
SUBMISSION_TO_EMAIL=info@radioaccu.com

# Private invite-only Guest Mix portal. The URL and secret are created by the
# Google Apps Script setup described in docs/GM_SERIES_WORKFLOW.md.
GOOGLE_APPS_SCRIPT_GM_WEBHOOK_URL=
GM_WEBHOOK_SECRET=
