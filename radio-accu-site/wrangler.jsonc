{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radio-accu-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "radioaccu.com", "custom_domain": true },
    { "pattern": "www.radioaccu.com", "custom_domain": true },
    { "pattern": "submit.radioaccu.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
